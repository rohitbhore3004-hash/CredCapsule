<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="1024dp"
    android:height="1024dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

  <!--
    FindTrack logo: a stylized open wallet with an upward tracking line inside.
    Represents wallet balance tracking — simple, bold, Material You.
    Background (in ic_launcher_background.xml): deep teal #00695C
    Foreground: white icon
  -->

  <!-- Wallet body: landscape rounded rectangle, thick stroke style -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="
        M 192,348
        C 192,296 234,254 286,254
        L 738,254
        C 790,254 832,296 832,348
        L 832,432
        L 192,432
        Z"/>

  <!-- Wallet lower body (card area) -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="
        M 192,432
        L 832,432
        L 832,676
        C 832,728 790,770 738,770
        L 286,770
        C 234,770 192,728 192,676
        Z"/>

  <!-- Wallet divider / flap separator (teal cutout to show division) -->
  <path
      android:fillColor="#00695C"
      android:pathData="M 192,424 L 832,424 L 832,442 L 192,442 Z"/>

  <!-- Coin/balance pocket on right side: circle bump -->
  <path
      android:fillColor="#00897B"
      android:pathData="
        M 668,522
        C 668,484 699,454 737,454
        L 832,454
        L 832,590
        L 737,590
        C 699,590 668,560 668,522
        Z"/>

  <!-- Coin circle center dot (white highlight in pocket) -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="
        M 772,522
        C 772,508 783,497 797,497
        C 811,497 822,508 822,522
        C 822,536 811,547 797,547
        C 783,547 772,536 772,522
        Z"/>

  <!-- Tracking graph line inside wallet (lower half, left area) -->
  <!-- Bar 1 (short) -->
  <path
      android:fillColor="#00695C"
      android:pathData="M 240,700 L 240,640 L 292,640 L 292,700 Z"/>
  <!-- Bar 2 (medium) -->
  <path
      android:fillColor="#00695C"
      android:pathData="M 316,700 L 316,600 L 368,600 L 368,700 Z"/>
  <!-- Bar 3 (tall) -->
  <path
      android:fillColor="#00695C"
      android:pathData="M 392,700 L 392,555 L 444,555 L 444,700 Z"/>
  <!-- Upward trend arrow line (on top of bars) -->
  <path
      android:fillColor="#FFFFFF"
      android:strokeColor="#FFFFFF"
      android:strokeWidth="0"
      android:pathData="
        M 220,690
        C 240,660 255,645 266,622
        C 290,590 330,575 360,562
        C 400,545 430,530 460,502
        L 452,494
        L 480,490
        L 476,518
        L 468,510
        C 438,538 407,554 368,571
        C 338,583 297,598 272,632
        C 260,650 245,666 226,698
        Z"/>

</vector>
